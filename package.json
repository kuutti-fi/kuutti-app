{
  "name": "kuutti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kuutti monorepo root. Workspace members arrive with the M1 scaffold (#2).",
  "license": "SEE LICENSE IN LICENSE-EXCEPTION",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "dev": "pnpm --filter @kuutti/api dev",
    "env:up": "node --env-file-if-exists=.env scripts/dev-env.ts up",
    "env:down": "node --env-file-if-exists=.env scripts/dev-env.ts down",
    "env:status": "node --env-file-if-exists=.env scripts/dev-env.ts status",
    "env:doctor": "node scripts/doctor.ts",
    "aws:login": "infra/scripts/aws-login",
    "dev:mobile": "pnpm --filter @kuutti/mobile start --private-key-path keys/private-key.pem",
    "dev:admin": "pnpm --filter @kuutti/admin dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r run test",
    "check:scenarios": "node scripts/check-scenarios.ts",
    "i18n:translate": "pnpm --filter @kuutti/i18n translate",
    "openapi": "pnpm --filter @kuutti/api openapi",
    "check:schema-words": "node scripts/check-schema-words.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  },
  "dependencies": {
    "zod": "^4.6.2"
  }
}
