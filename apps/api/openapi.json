{
  "openapi": "3.1.0",
  "info": {
    "title": "Kuutti API",
    "version": "0.0.0",
    "description": "Free, non-commercial dating app for Finland. Every account is verified through a Finnish bank. Source: AGPL-3.0 with App Store exception."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "The access token from /auth/exchange or /auth/refresh."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "ok when the database answers and migrations are current; degraded otherwise."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "APP_VERSION injected at build time."
          },
          "commit": {
            "type": "string",
            "minLength": 1,
            "description": "Short git commit the build was made from."
          },
          "builtAt": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 8601 build timestamp."
          },
          "source": {
            "type": "string",
            "format": "uri",
            "description": "Where the source of the running service is published (AGPL-3.0 section 13), to be read with `commit`. A modified deployment points this at its own source."
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "description": "SELECT 1 answered within 500 ms."
          },
          "migrations": {
            "type": "string",
            "enum": [
              "current",
              "pending"
            ],
            "description": "Committed migrations compared with the ones applied to this database."
          }
        },
        "required": [
          "status",
          "version",
          "commit",
          "builtAt",
          "source",
          "db",
          "migrations"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stable machine-readable code."
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "description": "Short, generic, safe to show."
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "description": "Matches the API log line."
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AuthExchangeResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "description": "This device's session; the app keeps it with the tokens."
          },
          "accessToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Bearer token; valid until accessExpiresAt."
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Single use: /auth/refresh answers with a new pair and retires this one."
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "After this the device logs in through the bank again."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "resumed"
            ],
            "description": "created: a fresh account (first login or after a cooldown); resumed: the live account."
          }
        },
        "required": [
          "sessionId",
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt",
          "outcome"
        ]
      },
      "AuthExchangeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "The one-time code the deep link carried."
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "SessionTokens": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "description": "This device's session; the app keeps it with the tokens."
          },
          "accessToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Bearer token; valid until accessExpiresAt."
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Single use: /auth/refresh answers with a new pair and retires this one."
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "After this the device logs in through the bank again."
          }
        },
        "required": [
          "sessionId",
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt"
        ]
      },
      "AuthRefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "refreshToken"
        ],
        "additionalProperties": false
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "$ref": "#/components/schemas/AuthPlatform"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "sessionId",
          "accountId",
          "platform",
          "createdAt",
          "refreshExpiresAt"
        ]
      },
      "AuthPlatform": {
        "type": "string",
        "enum": [
          "ios",
          "android"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness and readiness in one answer",
        "description": "200 when the database answers and committed migrations are applied; 503 with the same body when either fails.",
        "responses": {
          "200": {
            "description": "Every dependency answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable or migrations pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/start": {
      "get": {
        "summary": "Begin a bank login",
        "description": "Opened in the system browser by the app. Redirects to the identification broker's bank chooser; the person comes back through /auth/callback and the app receives a one-time code by deep link.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ],
              "description": "The app that will receive the one-time code by deep link."
            },
            "required": true,
            "description": "The app that will receive the one-time code by deep link.",
            "name": "platform",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "fi",
                "sv",
                "en"
              ],
              "description": "The language of the bank chooser (ui_locales); defaults to the request's."
            },
            "required": false,
            "description": "The language of the bank chooser (ui_locales); defaults to the request's.",
            "name": "locale",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the broker."
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No identification broker is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "summary": "The broker's return",
        "description": "The registered redirect URI. Exchanges the code with the broker, derives the identity, applies the re-registration rule and redirects to the app's deep link with a one-time code. Never called by the app itself.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "required": false,
            "name": "error",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "required": false,
            "name": "error_description",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to kuutti://auth?code=… on success, or to kuutti://auth?error=<code> (auth_state_mismatch, auth_under_18, auth_banned, auth_suspended, auth_cooldown with &until=<date>, auth_provider_error) so the app shows the refusal."
          }
        }
      }
    },
    "/auth/exchange": {
      "post": {
        "summary": "Exchange the one-time code for a session",
        "description": "Single use, within 60 seconds of the callback. Answers with this device's access and refresh tokens; the app keeps both in secure storage.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthExchangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The device's session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthExchangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, used or expired code (auth_code_used).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate the session's tokens",
        "description": "Presents the refresh token, receives a new pair; the old refresh token is retired. Presenting a retired token ends the device's session (session_revoked): sign in through the bank again.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new pair.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Retired, revoked, expired or unknown refresh token (session_revoked).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "This device's session",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's own session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated, session_expired or session_revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Sign out this device",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "The session is ended; both tokens stop working."
          },
          "401": {
            "description": "unauthenticated, session_expired or session_revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout-all": {
      "post": {
        "summary": "Sign out every device",
        "description": "Recovery for a lost phone: every session of the account ends, including this one.",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "Every session of the account is ended."
          },
          "401": {
            "description": "unauthenticated, session_expired or session_revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
