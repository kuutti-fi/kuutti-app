{
  "openapi": "3.1.0",
  "info": {
    "title": "Kuutti API",
    "version": "0.0.0",
    "description": "Free, non-commercial dating app for Finland. Every account is verified through a Finnish bank. Source: AGPL-3.0 with App Store exception."
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "ok when the database answers and migrations are current; degraded otherwise."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "APP_VERSION injected at build time."
          },
          "commit": {
            "type": "string",
            "minLength": 1,
            "description": "Short git commit the build was made from."
          },
          "builtAt": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 8601 build timestamp."
          },
          "source": {
            "type": "string",
            "format": "uri",
            "description": "Where the source of the running service is published (AGPL-3.0 section 13), to be read with `commit`. A modified deployment points this at its own source."
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "description": "SELECT 1 answered within 500 ms."
          },
          "migrations": {
            "type": "string",
            "enum": [
              "current",
              "pending"
            ],
            "description": "Committed migrations compared with the ones applied to this database."
          }
        },
        "required": [
          "status",
          "version",
          "commit",
          "builtAt",
          "source",
          "db",
          "migrations"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stable machine-readable code."
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "description": "Short, generic, safe to show."
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "description": "Matches the API log line."
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AuthExchangeResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "resumed"
            ],
            "description": "created: a fresh account (first login or after a cooldown); resumed: the live account."
          }
        },
        "required": [
          "accountId",
          "outcome"
        ]
      },
      "AuthExchangeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "The one-time code the deep link carried."
          }
        },
        "required": [
          "code"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness and readiness in one answer",
        "description": "200 when the database answers and committed migrations are applied; 503 with the same body when either fails.",
        "responses": {
          "200": {
            "description": "Every dependency answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable or migrations pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/start": {
      "get": {
        "summary": "Begin a bank login",
        "description": "Opened in the system browser by the app. Redirects to the identification broker's bank chooser; the person comes back through /auth/callback and the app receives a one-time code by deep link.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ],
              "description": "The app that will receive the one-time code by deep link."
            },
            "required": true,
            "description": "The app that will receive the one-time code by deep link.",
            "name": "platform",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "fi",
                "sv",
                "en"
              ],
              "description": "The language of the bank chooser (ui_locales); defaults to the request's."
            },
            "required": false,
            "description": "The language of the bank chooser (ui_locales); defaults to the request's.",
            "name": "locale",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the broker."
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No identification broker is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "summary": "The broker's return",
        "description": "The registered redirect URI. Exchanges the code with the broker, derives the identity, applies the re-registration rule and redirects to the app's deep link with a one-time code. Never called by the app itself.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "required": false,
            "name": "error",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "required": false,
            "name": "error_description",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to kuutti://auth?code=… ."
          },
          "400": {
            "description": "Unknown or expired login attempt (auth_state_mismatch).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Refused: auth_under_18, auth_banned, auth_suspended or auth_cooldown.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The broker did not complete the login (auth_provider_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No identification broker is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/exchange": {
      "post": {
        "summary": "Exchange the one-time code",
        "description": "Single use, within 60 seconds of the callback. Sessions (#35) will answer with tokens.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthExchangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account this login resolved to.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthExchangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, used or expired code (auth_code_used).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
