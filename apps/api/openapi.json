{
  "openapi": "3.1.0",
  "info": {
    "title": "Kuutti API",
    "version": "0.0.0",
    "description": "Free, non-commercial dating app for Finland. Every account is verified through a Finnish bank. Source: AGPL-3.0 with App Store exception."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "The access token from /auth/exchange or /auth/refresh."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "ok when the database answers and migrations are current; degraded otherwise."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "APP_VERSION injected at build time."
          },
          "commit": {
            "type": "string",
            "minLength": 1,
            "description": "Short git commit the build was made from."
          },
          "builtAt": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 8601 build timestamp."
          },
          "source": {
            "type": "string",
            "format": "uri",
            "description": "Where the source of the running service is published (AGPL-3.0 section 13), to be read with `commit`. A modified deployment points this at its own source."
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "description": "SELECT 1 answered within 500 ms."
          },
          "migrations": {
            "type": "string",
            "enum": [
              "current",
              "pending"
            ],
            "description": "Committed migrations compared with the ones applied to this database."
          }
        },
        "required": [
          "status",
          "version",
          "commit",
          "builtAt",
          "source",
          "db",
          "migrations"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stable machine-readable code."
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "description": "Short, generic, safe to show."
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "description": "Matches the API log line."
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AuthExchangeResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "description": "This device's session; the app keeps it with the tokens."
          },
          "accessToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Bearer token; valid until accessExpiresAt."
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Single use: /auth/refresh answers with a new pair and retires this one."
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "After this the device logs in through the bank again."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "resumed"
            ],
            "description": "created: a fresh account (first login or after a cooldown); resumed: the live account."
          }
        },
        "required": [
          "sessionId",
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt",
          "outcome"
        ]
      },
      "AuthExchangeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "The one-time code the deep link carried."
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "SessionTokens": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "description": "This device's session; the app keeps it with the tokens."
          },
          "accessToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Bearer token; valid until accessExpiresAt."
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Single use: /auth/refresh answers with a new pair and retires this one."
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "After this the device logs in through the bank again."
          }
        },
        "required": [
          "sessionId",
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt"
        ]
      },
      "AuthRefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "refreshToken"
        ],
        "additionalProperties": false
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "$ref": "#/components/schemas/AuthPlatform"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "sessionId",
          "accountId",
          "platform",
          "createdAt",
          "refreshExpiresAt"
        ]
      },
      "AuthPlatform": {
        "type": "string",
        "enum": [
          "ios",
          "android"
        ]
      },
      "AdminSession": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "$ref": "#/components/schemas/ModeratorRole"
          }
        },
        "required": [
          "accessToken",
          "expiresAt",
          "role"
        ]
      },
      "ModeratorRole": {
        "type": "string",
        "enum": [
          "moderator",
          "admin",
          "researcher"
        ]
      },
      "AdminAuthExchangeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "AdminWhoAmI": {
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/ModeratorRole"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "role",
          "expiresAt"
        ]
      },
      "PhotoList": {
        "type": "object",
        "properties": {
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Photo"
            },
            "maxItems": 50
          },
          "maxPhotos": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "description": "matching_config max_photos."
          }
        },
        "required": [
          "photos",
          "maxPhotos"
        ]
      },
      "Photo": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PhotoId"
          },
          "blurhash": {
            "type": "string",
            "minLength": 6,
            "maxLength": 200,
            "description": "Placeholder the app paints before the thumb arrives (computed from the thumb)."
          },
          "width": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "description": "Of the full variant."
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "description": "Of the full variant."
          },
          "state": {
            "$ref": "#/components/schemas/PhotoState"
          },
          "rejectionReason": {
            "type": "string",
            "nullable": true,
            "enum": [
              "nudity",
              "no_person",
              "several_people",
              "minor",
              "violence",
              "contact_details",
              "other",
              null
            ],
            "description": "Set when state is rejected: the reason the owner is told."
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "description": "0 is the main photo; the owner sets the order."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "blurhash",
          "width",
          "height",
          "state",
          "rejectionReason",
          "position",
          "createdAt"
        ]
      },
      "PhotoId": {
        "type": "string",
        "format": "uuid"
      },
      "PhotoState": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "queued",
          "rejected"
        ]
      },
      "PhotoUploadRequest": {
        "type": "object",
        "properties": {
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "The picture, pre-resized to 1600 px by the app; JPEG, PNG or WebP."
          }
        },
        "required": [
          "photo"
        ],
        "additionalProperties": false
      },
      "PhotoOrderRequest": {
        "type": "object",
        "properties": {
          "order": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhotoId"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "order"
        ],
        "additionalProperties": false
      },
      "PhotoUrlResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "variant": {
            "$ref": "#/components/schemas/PhotoVariant"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "variant",
          "expiresAt"
        ]
      },
      "PhotoVariant": {
        "type": "string",
        "enum": [
          "thumb",
          "card",
          "full"
        ],
        "description": "thumb: 200×200 for lists. card: 800×1067 when a profile is opened. full: 1600 px long edge, requested only from the zoom screen."
      },
      "PhotoReviewQueue": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhotoReviewItem"
            },
            "maxItems": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "PhotoReviewItem": {
        "type": "object",
        "properties": {
          "photoId": {
            "$ref": "#/components/schemas/PhotoId"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/PhotoState"
          },
          "blurhash": {
            "type": "string",
            "minLength": 6,
            "maxLength": 200
          },
          "width": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "checkedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModerationLabel"
            },
            "maxItems": 50
          },
          "faces": {
            "type": "integer",
            "minimum": 0
          },
          "flagged": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 50
          }
        },
        "required": [
          "photoId",
          "accountId",
          "state",
          "blurhash",
          "width",
          "height",
          "uploadedAt",
          "checkedAt",
          "labels",
          "faces",
          "flagged"
        ]
      },
      "ModerationLabel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "parentName": {
            "type": "string",
            "maxLength": 100
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "name",
          "parentName",
          "confidence"
        ]
      },
      "PhotoDecisionResponse": {
        "type": "object",
        "properties": {
          "photoId": {
            "$ref": "#/components/schemas/PhotoId"
          },
          "state": {
            "$ref": "#/components/schemas/PhotoState"
          },
          "rejectionReason": {
            "$ref": "#/components/schemas/PhotoRejectionReason"
          }
        },
        "required": [
          "photoId",
          "state",
          "rejectionReason"
        ]
      },
      "PhotoRejectionReason": {
        "type": "string",
        "nullable": true,
        "enum": [
          "nudity",
          "no_person",
          "several_people",
          "minor",
          "violence",
          "contact_details",
          "other",
          null
        ]
      },
      "PhotoDecisionRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "approve"
                ]
              }
            },
            "required": [
              "decision"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "reject"
                ]
              },
              "reason": {
                "$ref": "#/components/schemas/PhotoRejectionReason"
              }
            },
            "required": [
              "decision",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness and readiness in one answer",
        "description": "200 when the database answers and committed migrations are applied; 503 with the same body when either fails.",
        "responses": {
          "200": {
            "description": "Every dependency answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable or migrations pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/start": {
      "get": {
        "summary": "Begin a bank login",
        "description": "Opened in the system browser by the app. Redirects to the identification broker's bank chooser; the person comes back through /auth/callback and the app receives a one-time code by deep link.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ],
              "description": "The app that will receive the one-time code by deep link."
            },
            "required": true,
            "description": "The app that will receive the one-time code by deep link.",
            "name": "platform",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "fi",
                "sv",
                "en"
              ],
              "description": "The language of the bank chooser (ui_locales); defaults to the request's."
            },
            "required": false,
            "description": "The language of the bank chooser (ui_locales); defaults to the request's.",
            "name": "locale",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the broker."
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No identification broker is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "summary": "The broker's return",
        "description": "The registered redirect URI. Exchanges the code with the broker, derives the identity, applies the re-registration rule and redirects to the app's deep link with a one-time code. Never called by the app itself.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "required": false,
            "name": "error",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "required": false,
            "name": "error_description",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to kuutti://auth?code=… on success, or to kuutti://auth?error=<code> (auth_state_mismatch, auth_cancelled, auth_under_18, auth_banned, auth_suspended, auth_cooldown with &until=<date>, auth_provider_error) so the app shows the refusal."
          }
        }
      }
    },
    "/auth/exchange": {
      "post": {
        "summary": "Exchange the one-time code for a session",
        "description": "Single use, within 60 seconds of the callback. Answers with this device's access and refresh tokens; the app keeps both in secure storage.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthExchangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The device's session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthExchangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, used or expired code (auth_code_used).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate the session's tokens",
        "description": "Presents the refresh token, receives a new pair; the old refresh token is retired. Presenting a retired token ends the device's session (session_revoked): sign in through the bank again.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new pair.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Retired, revoked, expired or unknown refresh token (session_revoked).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "This device's session",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's own session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated, session_expired or session_revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Sign out this device",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "The session is ended; both tokens stop working."
          },
          "401": {
            "description": "unauthenticated, session_expired or session_revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout-all": {
      "post": {
        "summary": "Sign out every device",
        "description": "Recovery for a lost phone: every session of the account ends, including this one.",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "Every session of the account is ended."
          },
          "401": {
            "description": "unauthenticated, session_expired or session_revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/auth/start": {
      "get": {
        "summary": "Begin a staff bank login",
        "description": "Opened by the moderation panel. The same bank login as the app's, marked as a staff attempt: it resolves to an identity with a moderator role and creates nothing. The browser returns to the panel with a one-time code in the URL fragment, or with error=admin_not_allowed.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "fi",
                "sv",
                "en"
              ],
              "description": "The language of the bank chooser; defaults to the request's."
            },
            "required": false,
            "description": "The language of the bank chooser; defaults to the request's.",
            "name": "locale",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the broker."
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No identification broker is configured.",
            "content": {
