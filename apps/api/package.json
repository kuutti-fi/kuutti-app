{
  "name": "@kuutti/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono on Node. One process: HTTP routes, WebSockets, nightly jobs.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@kuutti/schema": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
