# cp to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# gh api repos/kuutti-fi/kuutti-app --jq '{repo_id: .id, owner_id: .owner.id}'

github_owner_id      = "000000000"
github_repository_id = "000000000"

# Alias on the project domain (TD-4), never a personal address. Confirm the SNS
# subscription from that mailbox after apply.
billing_alert_email = "billing@example.invalid"

# monthly_budget_usd = 55   # TD-4: 50 EUR, in USD because Budgets are USD

# GitHub organisation domain verification (#16 B.1). Settings of the
# organisation, Verified and approved domains, Add a domain: copy the record
# name (without the domain) and the code here, apply, then press Verify.
# github_domain_verification = {
#   name = "_gh-kuutti-fi-o"
#   code = "0123abcdef"
# }
