{
  "name": "@kuutti/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, generated migrations, the locked migrate runner, the seed, and the hetu format helper.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "check": "drizzle-kit check",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/cli/seed.ts",
    "moderator": "node --env-file-if-exists=../../.env --import tsx src/cli/moderator.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.10.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
