# Copy to .env at the repository root: `cp env.example .env`. The runtime reads
# .env (node --env-file); tooling and agents never open it. Everything here is a
# local development value and nothing here is a secret: deployed environments
# read their configuration from SSM Parameter Store (TD-19).

# --- API ---
APP_ENV=development
LOG_LEVEL=info
PORT=3000

# Postgres from docker compose (or Homebrew PostgreSQL with the same role and database).
DATABASE_URL=postgres://kuutti:kuutti@127.0.0.1:5432/kuutti
DB_POOL_MAX=10

# Browser origins allowed to call the API. Development defaults to the Metro web
# target when unset; leave commented unless you serve the web target elsewhere.
# CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Object storage: MinIO from docker compose stands in for S3 (TD-2) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
S3_BUCKET=kuutti-media
S3_ACCESS_KEY=kuutti
S3_SECRET_KEY=kuutti-dev-only
S3_FORCE_PATH_STYLE=true

# --- Bank identification: the mock IdP from docker compose stands in for the Telia broker ---
# Real Telia test-bed values exist only on staging (fixed redirect URIs, TD-2).
OIDC_ISSUER=http://127.0.0.1:8080/ftn
OIDC_CLIENT_ID=kuutti-local
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Error reporting (#11) ---
# Off locally. Deployed environments read /kuutti/<env>/sentry-dsn; a DSN is public.
# SENTRY_DSN=

# --- Mobile app ---
# Derived from the Metro host when unset, so a phone on the same network reaches
# this machine. Set only when the API runs elsewhere.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Error reporting in the app is off locally too; EAS environments carry the DSN.
# EXPO_PUBLIC_SENTRY_DSN=
