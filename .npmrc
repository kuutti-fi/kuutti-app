# pnpm reads nodeLinker from pnpm-workspace.yaml; kept here for older tooling that reads .npmrc.
node-linker=hoisted

# Dependabot's updater ships its own pnpm (11.x) and cannot download the version
# pinned in packageManager through its proxy, so with the default (true) every
# npm update run fails before it starts. Locally Corepack already installs the
# pinned version, so nothing is lost by turning the self-management off.
manage-package-manager-versions=false
